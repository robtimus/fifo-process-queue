{
  "name": "fifo-process-queue",
  "version": "1.2.1",
  "description": "A queue for processing data in FIFO order",
  "homepage": "https://github.com/robtimus/fifo-process-queue",
  "bugs": {
    "url": "https://github.com/robtimus/fifo-process-queue/issues"
  },
  "license": "Apache-2.0",
  "author": "Rob Spoor",
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/robtimus/fifo-process-queue.git"
  },
  "scripts": {
    "compile": "tsc",
    "lint": "eslint ./src/**",
    "format": "prettier --write \"**/*.+(json|ts|tsx)\"",
    "format:check": "prettier --check \"**/*.+(json|ts|tsx)\"",
    "build": "npm run format:check && npm run lint && npm run compile",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "printWidth": 180
  }
}
